{
  "openapi": "3.0.0",
  "info": {
    "title": "XFlow Projects API",
    "description": "XFlow项目管理模块API文档 - 提供项目创建、查询、更新、删除等功能",
    "version": "1.0.0",
    "contact": {
      "name": "XFlow Team",
      "email": "support@xflow.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "开发环境"
    }
  ],
  "tags": [
    {
      "name": "项目管理",
      "description": "项目的增删改查操作"
    },
    {
      "name": "项目类型",
      "description": "项目类型管理"
    }
  ],
  "paths": {
    "/projects/": {
      "get": {
        "tags": ["项目管理"],
        "summary": "获取用户的项目列表",
        "description": "获取当前用户的所有项目，支持分页和类型筛选",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "每页数量",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "项目类型筛选",
            "required": false,
            "schema": {
              "type": "string",
              "example": "web"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsListResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "projects": [
                      {
                        "_id": "507f1f77bcf86cd799439011",
                        "name": "我的项目",
                        "description": "项目描述",
                        "type": "web",
                        "user_id": "507f1f77bcf86cd799439012",
                        "created_at": "2024-01-01T10:00:00Z",
                        "updated_at": "2024-01-01T10:00:00Z"
                      }
                    ],
                    "pagination": {
                      "page": 1,
                      "per_page": 20,
                      "total": 1,
                      "pages": 1
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["项目管理"],
        "summary": "创建新项目",
        "description": "创建新的项目",
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "项目名称",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "我的新项目"
                  },
                  "description": {
                    "type": "string",
                    "description": "项目描述",
                    "maxLength": 500,
                    "example": "这是一个很棒的项目"
                  },
                  "type": {
                    "type": "string",
                    "description": "项目类型",
                    "example": "web"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "_id": "507f1f77bcf86cd799439011",
                    "name": "我的新项目",
                    "description": "这是一个很棒的项目",
                    "type": "web",
                    "user_id": "507f1f77bcf86cd799439012",
                    "created_at": "2024-01-01T10:00:00Z",
                    "updated_at": "2024-01-01T10:00:00Z"
                  },
                  "message": "项目创建成功"
                }
              }
            }
          },
          "400": {
            "description": "请求错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "name_exists": {
                    "summary": "项目名已存在",
                    "value": {
                      "success": false,
                      "message": "项目名已存在"
                    }
                  },
                  "validation_error": {
                    "summary": "参数验证失败",
                    "value": {
                      "success": false,
                      "message": "缺少必填字段: name"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/project/types": {
      "get": {
        "tags": ["项目类型"],
        "summary": "获取项目类型列表",
        "description": "获取所有可用的项目类型",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectTypesResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "_id": "507f1f77bcf86cd799439011",
                      "name": "Web应用",
                      "code": "web",
                      "description": "基于Web的应用程序"
                    },
                    {
                      "_id": "507f1f77bcf86cd799439012",
                      "name": "移动应用",
                      "code": "mobile",
                      "description": "移动端应用程序"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "tags": ["项目管理"],
        "summary": "获取项目详情",
        "description": "根据项目ID获取项目的详细信息",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "example": "507f1f77bcf86cd799439011"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "_id": "507f1f77bcf86cd799439011",
                    "name": "我的项目",
                    "description": "项目描述",
                    "type": "web",
                    "user_id": "507f1f77bcf86cd799439012",
                    "created_at": "2024-01-01T10:00:00Z",
                    "updated_at": "2024-01-01T10:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "项目不存在"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["项目管理"],
        "summary": "更新项目",
        "description": "更新项目的详细信息",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "example": "507f1f77bcf86cd799439011"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "项目名称",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "更新后的项目名"
                  },
                  "description": {
                    "type": "string",
                    "description": "项目描述",
                    "maxLength": 500,
                    "example": "更新后的项目描述"
                  },
                  "type": {
                    "type": "string",
                    "description": "项目类型",
                    "example": "mobile"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true,
                  "data": null,
                  "message": "项目更新成功"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "项目不存在"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["项目管理"],
        "summary": "删除项目",
        "description": "删除项目及其相关数据（流量记录、任务、配置等）",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "example": "507f1f77bcf86cd799439011"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true,
                  "data": null,
                  "message": "项目删除成功"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "项目不存在"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT令牌认证，格式：Bearer <token>"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "description": "响应数据"
          },
          "message": {
            "type": "string",
            "description": "响应消息",
            "example": "操作成功"
          }
        },
        "required": ["success", "message"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "description": "错误消息",
            "example": "操作失败"
          }
        },
        "required": ["success", "message"]
      },
      "Project": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "项目ID",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "description": "项目名称",
            "minLength": 1,
            "maxLength": 100,
            "example": "我的项目"
          },
          "description": {
            "type": "string",
            "description": "项目描述",
            "maxLength": 500,
            "example": "这是一个很棒的项目"
          },
          "type": {
            "type": "string",
            "description": "项目类型",
            "example": "web"
          },
          "user_id": {
            "type": "string",
            "description": "用户ID",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "507f1f77bcf86cd799439012"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间",
            "example": "2024-01-01T10:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "更新时间",
            "example": "2024-01-01T10:00:00Z"
          }
        },
        "required": ["_id", "name", "user_id", "created_at", "updated_at"]
      },
      "ProjectResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Project"
              }
            }
          }
        ]
      },
      "ProjectsListResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "projects": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Project"
                    }
                  },
                  "pagination": {
                    "$ref": "#/components/schemas/PaginationInfo"
                  }
                },
                "required": ["projects", "pagination"]
              }
            }
          }
        ]
      },
      "ProjectType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "类型ID",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "description": "类型名称",
            "example": "Web应用"
          },
          "code": {
            "type": "string",
            "description": "类型代码",
            "example": "web"
          },
          "description": {
            "type": "string",
            "description": "类型描述",
            "example": "基于Web的应用程序"
          }
        },
        "required": ["_id", "name", "code"]
      },
      "ProjectTypesResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProjectType"
                }
              }
            }
          }
        ]
      },
      "PaginationInfo": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "当前页码",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "description": "每页数量",
            "example": 20
          },
          "total": {
            "type": "integer",
            "description": "总数量",
            "example": 100
          },
          "pages": {
            "type": "integer",
            "description": "总页数",
            "example": 5
          }
        },
        "required": ["page", "per_page", "total", "pages"]
      }
    }
  }
}
